{
	"type": "record",
	"name": "OrderCreated",
	"namespace": "com.example.events.orders",
	"doc": "Um pedido foi criado e aguarda a reserva de estoque.",
	"fields": [
		{"name": "eventId", "type": "string", "doc": "UUID do evento; base da deduplicação nos consumidores."},
		{"name": "orderId", "type": "string"},
		{"name": "aggregateVersion", "type": "int"},
		{"name": "occurredAt", "type": "long", "doc": "Milissegundos desde 1970-01-01T00:00:00Z (UTC)."},
		{"name": "customerId", "type": "string"},
		{"name": "total", "type": "string", "doc": "Decimal em texto, ex.: \"359.50\"."},
		{"name": "items", "type": {"type": "array", "items": {
			"type": "record", "name": "OrderLine",
			"fields": [
				{"name": "sku", "type": "string"},
				{"name": "quantity", "type": "int"},
				{"name": "unitPrice", "type": "string"}
			]}}}
	]
}